{
  "name": "xyvora-site",
  "type": "module",
  "version": "0.1.0",
  "description": "Xyvora - static blog powered by Astro, sourced from Obsidian vault",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test:node": "node --import tsx --test tests/*.test.ts",
    "test:python": "python3 -m unittest discover -s tests -p 'test_*.py'",
    "test": "npm run test:node && npm run test:python"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.4",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/sitemap": "^3.7.2",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^6.3.1",
    "fuse.js": "^7.3.0",
    "mermaid": "^11.0.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-slug": "^6.0.0",
    "remark-math": "^6.0.0",
    "tailwindcss": "^4.3.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "tsx": "^4.22.4"
  }
}
