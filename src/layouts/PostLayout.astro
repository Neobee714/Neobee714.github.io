---
/**
 * PostLayout — article detail page layout.
 * Premium minimal design: AICover at top, huge title, two-column (TOC + content).
 * Includes reading progress, comments, back-to-top.
 */
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import AICover from '@/components/AICover.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import BackToTop from '@/components/BackToTop.astro';
import Giscus from '@/components/Giscus.astro';
import CodeBlockWrapper from '@/components/CodeBlockWrapper.astro';
import MermaidIsland from '@/components/islands/MermaidIsland.tsx';
import { getCategory, getDateIso, isLocked } from '@/lib/obsidian-parser';
import type { Post } from '@/lib/obsidian-parser';

interface Props {
  post: Post;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;

const slug = post.data.Slug!;
const category = getCategory(post);
const dateStr = getDateIso(post);
const locked = isLocked(post);
const tags = post.data.tags || [];
const summary = post.data.简介 || '';

// Derive Chinese title from file path
const segments = post.id.replace(/\.md$/, '').split('/');
const titleZh = segments[segments.length - 1];

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://neobee.top';
const postUrl = `${siteUrl}/post/${slug}/`;

// Schema.org JSON-LD for BlogPosting
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titleZh,
  datePublished: dateStr || undefined,
  author: {
    '@type': 'Person',
    name: 'Xyvora',
  },
  description: summary || `${titleZh} - Xyvora`,
  url: postUrl,
});
---

<BaseLayout
  title={`${titleZh} - Xyvora`}
  description={summary || `${titleZh} - Xyvora`}
  ogType="article"
  canonical={postUrl}
>
  <ReadingProgress />

  <div class="max-w-5xl mx-auto px-6 py-14">
    <!-- AICover -->
    <AICover category={category} title={titleZh} slug={slug} />

    <!-- Title -->
    <h1 class="mt-8 text-5xl md:text-7xl font-semibold tracking-tight">{titleZh}</h1>

    <!-- Description / Meta -->
    {summary && <p class="mt-4 text-2xl text-[var(--text-muted)]">{summary}</p>}

    <div class="flex items-center gap-4 mt-4 text-sm text-[var(--text-muted)]">
      {dateStr && <time datetime={dateStr}>{dateStr}</time>}
      {category && <span class="uppercase tracking-wide">{category}</span>}
      {locked && <span title="Locked">🔒</span>}
    </div>

    {tags.length > 0 && (
      <div class="flex flex-wrap gap-2 mt-4">
        {tags.map((tag) => (
          <a
            href={`/tags/${tag}/`}
            class="text-xs px-3 py-1 rounded-lg border border-[var(--border)] text-[var(--text-muted)] no-underline hover:border-[var(--border-hover)] hover:text-[var(--text)] transition-colors"
          >
            {tag}
          </a>
        ))}
      </div>
    )}

    <!-- Two-column: content + TOC sidebar (right) -->
    <div class="grid lg:grid-cols-[1fr_200px] gap-10 mt-12">
      <!-- Article Content -->
      <article class="post-content space-y-8 text-lg leading-9 text-[var(--text-muted)] min-w-0">
        <slot />
      </article>

      <!-- TOC Sidebar (right) -->
      <aside class="hidden lg:block">
        <div class="sticky top-24">
          <TableOfContents headings={headings} />
        </div>
      </aside>
    </div>

    <!-- Comments -->
    {!locked && <div class="mt-16"><Giscus /></div>}
  </div>

  <BackToTop />
  <CodeBlockWrapper />
  <MermaidIsland client:visible />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={jsonLd} />
</BaseLayout>

<style>
  .post-content :global(h1),
  .post-content :global(h2),
  .post-content :global(h3),
  .post-content :global(h4) {
    color: var(--text);
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .post-content :global(h2) {
    font-size: 1.75rem;
  }

  .post-content :global(h3) {
    font-size: 1.375rem;
  }

  .post-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .post-content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .post-content :global(a:hover) {
    opacity: 0.8;
  }

  .post-content :global(code) {
    background: var(--code-bg);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    font-size: 0.875em;
  }

  .post-content :global(pre) {
    background: var(--code-bg);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    padding: 1.25rem;
    overflow-x: auto;
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .post-content :global(pre code) {
    background: none;
    padding: 0;
    border-radius: 0;
  }

  .post-content :global(blockquote) {
    border-left: 3px solid var(--accent);
    padding-left: 1rem;
    color: var(--text-muted);
    font-style: italic;
  }

  .post-content :global(img) {
    border-radius: 0.75rem;
    max-width: 100%;
    height: auto;
  }

  .post-content :global(ul),
  .post-content :global(ol) {
    padding-left: 1.5rem;
    margin-bottom: 1.25rem;
  }

  .post-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .post-content :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin-bottom: 1.25rem;
  }

  .post-content :global(th),
  .post-content :global(td) {
    border: 1px solid var(--border);
    padding: 0.5rem 0.75rem;
    text-align: left;
  }

  .post-content :global(th) {
    background: var(--bg-elevated);
    font-weight: 600;
  }
</style>
