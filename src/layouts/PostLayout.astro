---
/**
 * PostLayout — article detail page layout.
 * Two-column: main content (left) + TOC sidebar (right, hidden on mobile).
 * Includes reading progress, article meta, comments, back-to-top.
 */
import BaseLayout from './BaseLayout.astro';
import ReadingProgress from '@/components/ReadingProgress.astro';
import TableOfContents from '@/components/TableOfContents.astro';
import BackToTop from '@/components/BackToTop.astro';
import Giscus from '@/components/Giscus.astro';
import CodeBlockWrapper from '@/components/CodeBlockWrapper.astro';
import MermaidIsland from '@/components/islands/MermaidIsland.tsx';
import { getCategory, getDateIso, isLocked } from '@/lib/obsidian-parser';
import type { Post } from '@/lib/obsidian-parser';

interface Props {
  post: Post;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;

const slug = post.data.Slug!;
const category = getCategory(post);
const dateStr = getDateIso(post);
const locked = isLocked(post);
const tags = post.data.tags || [];
const summary = post.data.简介 || '';

// Derive Chinese title from file path
const segments = post.id.replace(/\.md$/, '').split('/');
const titleZh = segments[segments.length - 1];

const siteUrl = import.meta.env.PUBLIC_SITE_URL || 'https://neobee.top';
const postUrl = `${siteUrl}/post/${slug}/`;

// Schema.org JSON-LD for BlogPosting
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: titleZh,
  datePublished: dateStr || undefined,
  author: {
    '@type': 'Person',
    name: 'Xyvora',
  },
  description: summary || `${titleZh} - Xyvora`,
  url: postUrl,
});
---

<BaseLayout
  title={`${titleZh} - Xyvora`}
  description={summary || `${titleZh} - Xyvora`}
  ogType="article"
  canonical={postUrl}
>
  <ReadingProgress />

  <div class="post-layout">
    <article class="post-layout__main">
      <!-- Article header -->
      <header class="post-header">
        <h1 class="post-header__title">{titleZh}</h1>
        <div class="post-header__meta">
          {dateStr && <time class="post-header__date" datetime={dateStr}>{dateStr}</time>}
          {category && <span class="post-header__category">{category}</span>}
          {locked && <span class="post-header__locked">🔒</span>}
        </div>
        {tags.length > 0 && (
          <div class="post-header__tags">
            {tags.map((tag) => (
              <a href={`/tags/${tag}/`} class="post-header__tag">{tag}</a>
            ))}
          </div>
        )}
      </header>

      <!-- Article content -->
      <div class="post-content prose">
        <slot />
      </div>

      <!-- Comments -->
      {!locked && <Giscus />}
    </article>

    <!-- TOC sidebar (hidden on mobile) -->
    <aside class="post-layout__sidebar">
      <TableOfContents headings={headings} />
    </aside>
  </div>

  <BackToTop />
  <CodeBlockWrapper />
  <MermaidIsland client:visible />

  <!-- Schema.org JSON-LD -->
  <script type="application/ld+json" set:html={jsonLd} />
</BaseLayout>

<style>
  .post-layout {
    display: flex;
    gap: 3rem;
    max-width: 1200px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .post-layout__main {
    flex: 1;
    min-width: 0;
    max-width: 780px;
  }

  .post-layout__sidebar {
    flex: 0 0 220px;
  }

  .post-header {
    margin-bottom: 2rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  .post-header__title {
    margin: 0 0 0.75rem;
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .post-header__meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
  }

  .post-header__date {
    font-variant-numeric: tabular-nums;
  }

  .post-header__category {
    font-weight: 500;
    color: var(--primary);
    background: var(--primary-soft);
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.6875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .post-header__locked {
    font-size: 0.875rem;
  }

  .post-header__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: 0.75rem;
  }

  .post-header__tag {
    font-size: 0.6875rem;
    color: var(--text-dim);
    background: var(--bg-elevated);
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    border: 1px solid var(--border);
    text-decoration: none;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .post-header__tag:hover {
    color: var(--primary);
    border-color: var(--primary);
  }

  .post-content {
    line-height: 1.8;
    font-size: 1rem;
  }

  @media (max-width: 1024px) {
    .post-layout__sidebar {
      display: none;
    }
  }
</style>
