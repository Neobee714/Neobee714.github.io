---
/**
 * Hero — homepage hero section.
 * Left: Brand + subtitle + CTAs.
 * Right: Terminal animation (React island, client:visible).
 * Gradient glow effect behind the terminal.
 */
import TerminalAnim from './islands/TerminalAnim.tsx';
---

<section class="hero">
  <div class="hero__content">
    <div class="hero__left">
      <h1 class="hero__brand">Xyvora</h1>
      <p class="hero__subtitle">
        <span class="lang-zh">安全研究 · 渗透测试 · 技术笔记</span>
        <span class="lang-en">Security Research · Pentesting · Tech Notes</span>
      </p>
      <div class="hero__ctas">
        <a href="/" class="hero__cta hero__cta--primary">
          <span class="lang-zh">浏览文章 →</span>
          <span class="lang-en">Browse Posts →</span>
        </a>
        <a href="https://github.com/Neobee714" class="hero__cta hero__cta--secondary" target="_blank" rel="noopener">
          GitHub ↗
        </a>
      </div>
    </div>

    <div class="hero__right">
      <div class="hero__glow"></div>
      <TerminalAnim client:visible />
    </div>
  </div>
</section>

<style>
  .hero {
    padding: 4rem 1.5rem;
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero__content {
    display: flex;
    align-items: center;
    gap: 3rem;
  }

  .hero__left {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .hero__brand {
    margin: 0;
    font-size: 3rem;
    font-weight: 800;
    background: linear-gradient(135deg, var(--primary), #34d399);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero__subtitle {
    margin: 0;
    font-size: 1.125rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .hero__ctas {
    display: flex;
    gap: 1rem;
    margin-top: 0.5rem;
  }

  .hero__cta {
    display: inline-flex;
    align-items: center;
    padding: 0.625rem 1.25rem;
    border-radius: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    text-decoration: none;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .hero__cta:hover {
    transform: translateY(-1px);
  }

  .hero__cta--primary {
    background: var(--primary);
    color: #fff;
  }

  .hero__cta--primary:hover {
    box-shadow: 0 4px 12px rgba(16, 185, 129, 0.3);
  }

  .hero__cta--secondary {
    background: var(--bg-elevated);
    color: var(--text);
    border: 1px solid var(--border);
  }

  .hero__right {
    flex: 1;
    position: relative;
  }

  .hero__glow {
    position: absolute;
    inset: -20%;
    background: radial-gradient(ellipse at center, rgba(16, 185, 129, 0.15), transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero__right :global(.terminal-anim) {
    position: relative;
    z-index: 1;
    background: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    overflow: hidden;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
    font-size: 0.8125rem;
  }

  .hero__right :global(.terminal-anim__header) {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1rem;
    background: #161b22;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .hero__right :global(.terminal-anim__dot) {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
  }

  .hero__right :global(.terminal-anim__dot--red) { background: #ff5f57; }
  .hero__right :global(.terminal-anim__dot--yellow) { background: #febc2e; }
  .hero__right :global(.terminal-anim__dot--green) { background: #28c840; }

  .hero__right :global(.terminal-anim__dot-title) {
    margin-left: 0.5rem;
    font-size: 0.6875rem;
    color: #8b949e;
  }

  .hero__right :global(.terminal-anim__body) {
    padding: 1rem;
    min-height: 180px;
  }

  .hero__right :global(.terminal-anim__line) {
    color: #c9d1d9;
    line-height: 1.8;
    white-space: nowrap;
  }

  .hero__right :global(.terminal-anim__cursor) {
    color: var(--primary);
  }

  @media (max-width: 768px) {
    .hero__content {
      flex-direction: column;
    }
    .hero__brand {
      font-size: 2.25rem;
    }
  }
</style>
