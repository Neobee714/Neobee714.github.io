---
/**
 * AICover — decorative placeholder card when no cover image exists.
 * Maps category to a gradient color scheme; renders title + category badge
 * over a CSS grid pattern. Matches premium minimal design.
 *
 * Validates: REQ-07-3, REQ-07-6
 */
interface Props {
  category?: string;
  title: string;
  slug: string;
}

const { category = '', title, slug } = Astro.props;

// Category → Tailwind gradient class mapping
const gradientMap: Record<string, string> = {
  HTB:         'from-emerald-500/20',
  Security:    'from-cyan-500/20',
  方法论:      'from-cyan-500/20',
  PortSwigger: 'from-rose-500/20',
  工具:        'from-indigo-500/20',
  Tech:        'from-indigo-500/20',
  CTF:         'from-violet-500/20',
};
const gradientClass = gradientMap[category] || 'from-zinc-500/20';
---

<div
  class="ai-cover h-48 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] relative overflow-hidden"
  data-slug={slug}
>
  <div class={`absolute inset-0 bg-gradient-to-br ${gradientClass} to-transparent`}></div>
  <div class="absolute inset-0 opacity-20 bg-[linear-gradient(rgba(255,255,255,0.12)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.12)_1px,transparent_1px)] bg-[size:22px_22px]"></div>
  <div class="absolute top-4 left-4 text-[10px] uppercase tracking-[0.3em] text-zinc-400">AI Cover</div>
  <div class="absolute left-5 right-5 bottom-5">
    <div class="text-xs uppercase tracking-[0.25em] text-zinc-400">{category || 'Blog'}</div>
    <h3 class="mt-2 text-xl font-semibold leading-tight text-[var(--text)] m-0 line-clamp-2">{title}</h3>
  </div>
</div>
