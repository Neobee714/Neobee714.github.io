---
/**
 * AICover — decorative placeholder card when no cover image exists.
 * Uses multiple reusable cover templates with deterministic per-post variation.
 * Theme-aware: light and dark modes render distinct visual treatments.
 */
interface Props {
  category?: string;
  title: string;
  slug: string;
  publishedAt?: string;
}

const { category = '', title, slug, publishedAt = '' } = Astro.props;

const normalizedCategory = category.trim().toLowerCase();
const source = `${slug}:${title}:${category}`;
const seed = [...source].reduce((sum, char, index) => sum + char.charCodeAt(0) * (index + 1), 0);

const themedPools: Record<string, readonly string[]> = {
  htb: ['mesh', 'topology', 'blueprint', 'signal', 'grid', 'terminal', 'radar', 'schematic', 'beams', 'orbits', 'lattice', 'waveform', 'nodes', 'slates', 'prism'],
  'active directory': ['topology', 'glass', 'signal', 'terminal', 'schematic', 'radar', 'nodes', 'lattice'],
  research: ['glass', 'blueprint', 'topology', 'shards', 'grid', 'beams', 'schematic', 'waveform', 'prism'],
  mazesec: ['blueprint', 'mesh', 'signal', 'shards', 'radar', 'orbits', 'slates'],
  ctf: ['mesh', 'topology', 'glass', 'signal', 'terminal', 'beams', 'radar', 'waveform', 'prism'],
  security: ['topology', 'mesh', 'glass', 'grid', 'signal', 'schematic', 'radar', 'nodes', 'lattice'],
  tech: ['glass', 'blueprint', 'grid', 'terminal', 'beams', 'waveform', 'slates'],
  工具: ['blueprint', 'glass', 'grid', 'schematic', 'lattice'],
  方法论: ['topology', 'mesh', 'signal', 'schematic', 'nodes'],
  学习: ['glass', 'blueprint', 'grid', 'beams', 'orbits'],
};

const fallbackThemes = ['mesh', 'topology', 'glass', 'blueprint', 'signal', 'shards', 'grid', 'terminal', 'radar', 'schematic', 'beams', 'orbits', 'lattice', 'waveform', 'nodes', 'slates', 'prism'] as const;
const themePool = themedPools[normalizedCategory] || fallbackThemes;
const publishedDays = /^\d{4}-\d{2}-\d{2}$/.test(publishedAt)
  ? Math.floor(Date.parse(`${publishedAt}T00:00:00Z`) / 86400000)
  : null;
const themeIndex = publishedDays !== null ? Math.abs(publishedDays) % themePool.length : seed % themePool.length;
const theme = themePool[themeIndex];

const coverStyle = [
  `--cover-accent-x:${12 + (seed % 24)}%`,
  `--cover-accent-y:${10 + (seed % 18)}%`,
  `--cover-secondary-x:${62 + (seed % 16)}%`,
  `--cover-secondary-y:${56 + (seed % 18)}%`,
  `--cover-ring-size:${8.5 + (seed % 4) * 0.55}rem`,
  `--cover-ring-top:${-2.8 + (seed % 3) * 0.5}rem`,
  `--cover-ring-right:${1.4 + (seed % 4) * 0.45}rem`,
  `--cover-glow-size:${14 + (seed % 5) * 1.1}rem`,
  `--cover-glass-a-rotate:${-9 - (seed % 5)}deg`,
  `--cover-glass-b-rotate:${5 + (seed % 5)}deg`,
  `--cover-frame-inset:${1.8 + (seed % 3) * 0.35}rem`,
  `--cover-circle-left:${2.6 + (seed % 4) * 0.45}rem`,
  `--cover-diamond-right:${2.5 + (seed % 4) * 0.35}rem`,
].join(';');
---

<div
  class={`ai-cover ai-cover--${theme}`}
  data-slug={slug}
  data-theme={theme}
  style={coverStyle}
>
  <div class="ai-cover__shine"></div>

  {theme === 'mesh' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--mesh-gradient"></div>
      <div class="ai-cover__layer ai-cover__layer--mesh-highlight"></div>
      <div class="ai-cover__ring"></div>
      <div class="ai-cover__glow"></div>
    </>
  )}

  {theme === 'topology' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--topology-gradient"></div>
      <svg class="ai-cover__svg" viewBox="0 0 100 100" aria-hidden="true">
        <line x1="20" y1="20" x2="70" y2="40"></line>
        <line x1="70" y1="40" x2="50" y2="80"></line>
        <line x1="30" y1="70" x2="50" y2="80"></line>
        <circle cx="20" cy="20" r="3"></circle>
        <circle cx="70" cy="40" r="3"></circle>
        <circle cx="50" cy="80" r="3"></circle>
        <circle cx="30" cy="70" r="3"></circle>
      </svg>
      <div class="ai-cover__layer ai-cover__layer--topology-grid"></div>
    </>
  )}

  {theme === 'glass' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--glass-gradient"></div>
      <div class="ai-cover__glass ai-cover__glass--a"></div>
      <div class="ai-cover__glass ai-cover__glass--b"></div>
      <div class="ai-cover__layer ai-cover__layer--glass-radial"></div>
    </>
  )}

  {theme === 'blueprint' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--blueprint-gradient"></div>
      <div class="ai-cover__layer ai-cover__layer--blueprint-grid"></div>
      <div class="ai-cover__frame"></div>
      <div class="ai-cover__circle"></div>
      <div class="ai-cover__diamond"></div>
    </>
  )}

  {theme === 'signal' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--signal-gradient"></div>
      <div class="ai-cover__signal ai-cover__signal--h"></div>
      <div class="ai-cover__signal ai-cover__signal--v"></div>
      <div class="ai-cover__signal-node ai-cover__signal-node--a"></div>
      <div class="ai-cover__signal-node ai-cover__signal-node--b"></div>
      <div class="ai-cover__signal-node ai-cover__signal-node--c"></div>
    </>
  )}

  {theme === 'shards' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--shards-gradient"></div>
      <div class="ai-cover__shard ai-cover__shard--a"></div>
      <div class="ai-cover__shard ai-cover__shard--b"></div>
      <div class="ai-cover__shard ai-cover__shard--c"></div>
    </>
  )}

  {theme === 'grid' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--grid-gradient"></div>
      <div class="ai-cover__layer ai-cover__layer--grid-matrix"></div>
      <div class="ai-cover__grid-box ai-cover__grid-box--a"></div>
      <div class="ai-cover__grid-box ai-cover__grid-box--b"></div>
    </>
  )}

  {theme === 'terminal' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--terminal-gradient"></div>
      <div class="ai-cover__terminal"></div>
      <div class="ai-cover__terminal-line ai-cover__terminal-line--a"></div>
      <div class="ai-cover__terminal-line ai-cover__terminal-line--b"></div>
      <div class="ai-cover__terminal-line ai-cover__terminal-line--c"></div>
    </>
  )}

  {theme === 'radar' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--radar-gradient"></div>
      <div class="ai-cover__radar-ring ai-cover__radar-ring--a"></div>
      <div class="ai-cover__radar-ring ai-cover__radar-ring--b"></div>
      <div class="ai-cover__radar-sweep"></div>
      <div class="ai-cover__radar-dot ai-cover__radar-dot--a"></div>
      <div class="ai-cover__radar-dot ai-cover__radar-dot--b"></div>
    </>
  )}

  {theme === 'schematic' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--schematic-gradient"></div>
      <div class="ai-cover__schematic-path ai-cover__schematic-path--a"></div>
      <div class="ai-cover__schematic-path ai-cover__schematic-path--b"></div>
      <div class="ai-cover__schematic-chip ai-cover__schematic-chip--a"></div>
      <div class="ai-cover__schematic-chip ai-cover__schematic-chip--b"></div>
      <div class="ai-cover__schematic-chip ai-cover__schematic-chip--c"></div>
    </>
  )}

  {theme === 'beams' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--beams-gradient"></div>
      <div class="ai-cover__beam ai-cover__beam--a"></div>
      <div class="ai-cover__beam ai-cover__beam--b"></div>
      <div class="ai-cover__beam ai-cover__beam--c"></div>
      <div class="ai-cover__beam-glow"></div>
    </>
  )}

  {theme === 'orbits' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--orbits-gradient"></div>
      <div class="ai-cover__orbit ai-cover__orbit--a"></div>
      <div class="ai-cover__orbit ai-cover__orbit--b"></div>
      <div class="ai-cover__orbit ai-cover__orbit--c"></div>
      <div class="ai-cover__orbit-dot ai-cover__orbit-dot--a"></div>
      <div class="ai-cover__orbit-dot ai-cover__orbit-dot--b"></div>
    </>
  )}

  {theme === 'lattice' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--lattice-gradient"></div>
      <div class="ai-cover__lattice ai-cover__lattice--a"></div>
      <div class="ai-cover__lattice ai-cover__lattice--b"></div>
      <div class="ai-cover__lattice ai-cover__lattice--c"></div>
    </>
  )}

  {theme === 'waveform' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--waveform-gradient"></div>
      <div class="ai-cover__wave ai-cover__wave--a"></div>
      <div class="ai-cover__wave ai-cover__wave--b"></div>
      <div class="ai-cover__wave ai-cover__wave--c"></div>
    </>
  )}

  {theme === 'nodes' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--nodes-gradient"></div>
      <div class="ai-cover__node-link ai-cover__node-link--a"></div>
      <div class="ai-cover__node-link ai-cover__node-link--b"></div>
      <div class="ai-cover__node-link ai-cover__node-link--c"></div>
      <div class="ai-cover__node ai-cover__node--a"></div>
      <div class="ai-cover__node ai-cover__node--b"></div>
      <div class="ai-cover__node ai-cover__node--c"></div>
      <div class="ai-cover__node ai-cover__node--d"></div>
    </>
  )}

  {theme === 'slates' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--slates-gradient"></div>
      <div class="ai-cover__slate ai-cover__slate--a"></div>
      <div class="ai-cover__slate ai-cover__slate--b"></div>
      <div class="ai-cover__slate ai-cover__slate--c"></div>
    </>
  )}

  {theme === 'prism' && (
    <>
      <div class="ai-cover__layer ai-cover__layer--prism-gradient"></div>
      <div class="ai-cover__prism ai-cover__prism--a"></div>
      <div class="ai-cover__prism ai-cover__prism--b"></div>
      <div class="ai-cover__prism ai-cover__prism--c"></div>
    </>
  )}

  <div class="ai-cover__content">
    <div class="ai-cover__tag">{category || 'Blog'}</div>
    <h3 class="ai-cover__title">{title}</h3>
  </div>
</div>

<style>
  .ai-cover {
    position: relative;
    height: 12rem;
    overflow: hidden;
    border-radius: 1rem;
    border: 1px solid var(--border);
    background: #0b0e14;
    --cover-accent-x: 14%;
    --cover-accent-y: 12%;
    --cover-secondary-x: 74%;
    --cover-secondary-y: 72%;
    --cover-ring-size: 10rem;
    --cover-ring-top: -2.5rem;
    --cover-ring-right: 2.5rem;
    --cover-glow-size: 18rem;
    --cover-glass-a-rotate: -12deg;
    --cover-glass-b-rotate: 8deg;
    --cover-frame-inset: 2.5rem;
    --cover-circle-left: 3.5rem;
    --cover-diamond-right: 3.5rem;
  }

  .ai-cover__shine,
  .ai-cover__layer,
  .ai-cover__svg,
  .ai-cover__ring,
  .ai-cover__glow,
  .ai-cover__glass,
  .ai-cover__frame,
  .ai-cover__circle,
  .ai-cover__diamond,
  .ai-cover__signal,
  .ai-cover__signal-node,
  .ai-cover__shard,
  .ai-cover__grid-box,
  .ai-cover__terminal,
  .ai-cover__terminal-line,
  .ai-cover__radar-ring,
  .ai-cover__radar-sweep,
  .ai-cover__radar-dot,
  .ai-cover__schematic-path,
  .ai-cover__schematic-chip,
  .ai-cover__beam,
  .ai-cover__beam-glow,
  .ai-cover__orbit,
  .ai-cover__orbit-dot,
  .ai-cover__lattice,
  .ai-cover__wave,
  .ai-cover__node-link,
  .ai-cover__node,
  .ai-cover__slate,
  .ai-cover__prism {
    position: absolute;
  }

  .ai-cover__shine {
    inset: 0;
    background:
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.08), transparent 28%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.03), transparent);
    pointer-events: none;
  }

  .ai-cover__content {
    position: absolute;
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.25rem;
    z-index: 1;
  }

  .ai-cover__tag {
    color: #71717a;
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
  }

  .ai-cover__title {
    margin: 0.5rem 0 0;
    color: #f4f4f5;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  .ai-cover--mesh .ai-cover__layer--mesh-gradient {
    inset: 0;
    background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(16, 185, 129, 0.1) 56%, transparent 84%);
  }

  .ai-cover--mesh .ai-cover__layer--mesh-highlight {
    inset: 0;
    opacity: 0.4;
    background:
      radial-gradient(circle at var(--cover-accent-x) var(--cover-accent-y), rgba(255, 255, 255, 0.12), transparent 30%),
      radial-gradient(circle at var(--cover-secondary-x) var(--cover-secondary-y), rgba(16, 185, 129, 0.2), transparent 35%);
  }

  .ai-cover__ring {
    top: var(--cover-ring-top);
    right: var(--cover-ring-right);
    width: var(--cover-ring-size);
    height: var(--cover-ring-size);
    border: 1px solid rgba(34, 211, 238, 0.2);
    border-radius: 999px;
  }

  .ai-cover__glow {
    left: 0;
    bottom: 0;
    width: var(--cover-glow-size);
    height: var(--cover-glow-size);
    border-radius: 999px;
    background: rgba(6, 182, 212, 0.1);
    filter: blur(64px);
  }

  .ai-cover--topology .ai-cover__layer--topology-gradient {
    inset: 0;
    background: linear-gradient(135deg, rgba(249, 115, 22, 0.1), rgba(239, 68, 68, 0.05) 58%, transparent);
  }

  .ai-cover__svg {
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.4;
  }

  .ai-cover__svg line {
    stroke: rgba(255, 255, 255, 0.15);
    stroke-width: 1;
  }

  .ai-cover__svg circle {
    fill: rgba(251, 146, 60, 0.9);
  }

  .ai-cover__svg circle:nth-of-type(2) {
    fill: rgba(239, 68, 68, 0.9);
  }

  .ai-cover__svg circle:nth-of-type(3) {
    fill: rgba(255, 255, 255, 0.9);
  }

  .ai-cover--topology .ai-cover__layer--topology-grid {
    inset: 0;
    background:
      linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
    background-size: 24px 24px;
  }

  .ai-cover--glass .ai-cover__layer--glass-gradient {
    inset: 0;
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.15), rgba(217, 70, 239, 0.1) 58%, transparent);
  }

  .ai-cover__glass {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.04);
    backdrop-filter: blur(24px);
  }

  .ai-cover__glass--a {
    top: 2.5rem;
    left: 2.5rem;
    width: 14rem;
    height: 8rem;
    border-radius: 2rem;
    transform: rotate(var(--cover-glass-a-rotate));
  }

  .ai-cover__glass--b {
    right: 2.5rem;
    bottom: 2rem;
    width: 12rem;
    height: 7rem;
    border-radius: 1.75rem;
    transform: rotate(var(--cover-glass-b-rotate));
  }

  .ai-cover--glass .ai-cover__layer--glass-radial {
    inset: 0;
    background: radial-gradient(circle at top, rgba(168, 85, 247, 0.18), transparent 40%);
  }

  .ai-cover--blueprint .ai-cover__layer--blueprint-gradient {
    inset: 0;
    background: linear-gradient(135deg, rgba(14, 165, 233, 0.1), rgba(79, 70, 229, 0.05) 58%, transparent);
  }

  .ai-cover--blueprint .ai-cover__layer--blueprint-grid {
    inset: 0;
    opacity: 0.3;
    background:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 28px 28px;
  }

  .ai-cover__frame {
    top: var(--cover-frame-inset);
    right: var(--cover-frame-inset);
    bottom: var(--cover-frame-inset);
    left: var(--cover-frame-inset);
    border: 1px dashed rgba(34, 211, 238, 0.2);
    border-radius: 1rem;
  }

  .ai-cover__circle {
    top: 4rem;
    left: var(--cover-circle-left);
    width: 10rem;
    height: 10rem;
    border: 1px solid rgba(34, 211, 238, 0.2);
    border-radius: 999px;
  }

  .ai-cover__diamond {
    right: var(--cover-diamond-right);
    bottom: 3rem;
    width: 6rem;
    height: 6rem;
    border: 1px solid rgba(34, 211, 238, 0.2);
    transform: rotate(45deg);
  }

  .ai-cover--signal .ai-cover__layer--signal-gradient {
    inset: 0;
    background:
      radial-gradient(circle at 22% 25%, rgba(34, 197, 94, 0.16), transparent 24%),
      linear-gradient(135deg, rgba(20, 184, 166, 0.12), rgba(59, 130, 246, 0.08) 58%, transparent);
  }

  .ai-cover__signal {
    background: rgba(255, 255, 255, 0.14);
  }

  .ai-cover__signal--h {
    left: 18%;
    top: 34%;
    width: 56%;
    height: 1px;
  }

  .ai-cover__signal--v {
    left: 58%;
    top: 18%;
    width: 1px;
    height: 50%;
  }

  .ai-cover__signal-node {
    width: 0.7rem;
    height: 0.7rem;
    border-radius: 999px;
    box-shadow: 0 0 18px currentColor;
  }

  .ai-cover__signal-node--a {
    left: 18%;
    top: 31%;
    color: #22c55e;
    background: currentColor;
  }

  .ai-cover__signal-node--b {
    left: 56%;
    top: 31%;
    color: #38bdf8;
    background: currentColor;
  }

  .ai-cover__signal-node--c {
    left: 55.7%;
    top: 64%;
    color: #f59e0b;
    background: currentColor;
  }

  .ai-cover--shards .ai-cover__layer--shards-gradient {
    inset: 0;
    background:
      linear-gradient(135deg, rgba(168, 85, 247, 0.14), rgba(59, 130, 246, 0.08) 58%, transparent),
      radial-gradient(circle at top right, rgba(255, 255, 255, 0.1), transparent 28%);
  }

  .ai-cover__shard {
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(18px);
    clip-path: polygon(18% 0%, 100% 0%, 82% 100%, 0% 100%);
  }

  .ai-cover__shard--a {
    top: 1.8rem;
    left: 2rem;
    width: 8rem;
    height: 6.5rem;
    transform: rotate(-12deg);
  }

  .ai-cover__shard--b {
    right: 2.4rem;
    top: 2.3rem;
    width: 6.8rem;
    height: 5.4rem;
    transform: rotate(10deg);
  }

  .ai-cover__shard--c {
    right: 5rem;
    bottom: 2rem;
    width: 9rem;
    height: 4.8rem;
    transform: rotate(-8deg);
  }

  .ai-cover--grid .ai-cover__layer--grid-gradient {
    inset: 0;
    background:
      linear-gradient(135deg, rgba(14, 165, 233, 0.12), rgba(99, 102, 241, 0.08) 56%, transparent),
      radial-gradient(circle at top left, rgba(255, 255, 255, 0.1), transparent 28%);
  }

  .ai-cover--grid .ai-cover__layer--grid-matrix {
    inset: 0;
    background:
      linear-gradient(rgba(255, 255, 255, 0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.03) 1px, transparent 1px);
    background-size: 18px 18px;
  }

  .ai-cover__grid-box {
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.03);
  }

  .ai-cover__grid-box--a {
    left: 2rem;
    top: 2.2rem;
    width: 5rem;
    height: 5rem;
  }

  .ai-cover__grid-box--b {
    right: 2.2rem;
    bottom: 2rem;
    width: 6.4rem;
    height: 3.8rem;
  }

  .ai-cover--terminal .ai-cover__layer--terminal-gradient {
    inset: 0;
    background:
      linear-gradient(135deg, rgba(16, 185, 129, 0.12), rgba(6, 182, 212, 0.08) 55%, transparent),
      radial-gradient(circle at bottom right, rgba(255, 255, 255, 0.08), transparent 26%);
  }

  .ai-cover__terminal {
    left: 2rem;
    right: 2rem;
    top: 2rem;
    bottom: 2rem;
    border-radius: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.08);
    background: rgba(7, 9, 13, 0.28);
    backdrop-filter: blur(18px);
  }

  .ai-cover__terminal-line {
    left: 3rem;
    height: 0.5rem;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
  }

  .ai-cover__terminal-line--a {
    top: 3.3rem;
    width: 4.8rem;
  }

  .ai-cover__terminal-line--b {
    top: 4.7rem;
    width: 8rem;
  }

  .ai-cover__terminal-line--c {
    top: 6.1rem;
    width: 5.6rem;
    background: rgba(16, 185, 129, 0.22);
  }

  .ai-cover--radar .ai-cover__layer--radar-gradient {
    inset: 0;
    background:
      radial-gradient(circle at 50% 50%, rgba(34, 197, 94, 0.12), transparent 32%),
      linear-gradient(135deg, rgba(6, 182, 212, 0.1), rgba(16, 185, 129, 0.08) 58%, transparent);
  }

  .ai-cover__radar-ring {
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 999px;
  }

  .ai-cover__radar-ring--a {
    inset: 2.1rem 5rem;
  }

  .ai-cover__radar-ring--b {
    inset: 3.6rem 6.5rem;
  }

  .ai-cover__radar-sweep {
    left: 50%;
    top: 50%;
    width: 8rem;
    height: 1px;
    transform-origin: left center;
    transform: rotate(-28deg);
    background: linear-gradient(90deg, rgba(34, 197, 94, 0.7), transparent);
  }

  .ai-cover__radar-dot {
