---
/**
 * PostCard — card component for the homepage grid.
 * Shows cover, category, locked badge, title, summary, tags, date, reading time.
 * Bilingual DOM with `.lang-zh` / `.lang-en` classes.
 * Hover: float up + light shadow transition.
 *
 * Validates: REQ-07-2
 */
import AICover from './AICover.astro';
import { getCategory, getDateIso, isLocked } from '@/lib/obsidian-parser';
import type { Post } from '@/lib/obsidian-parser';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const slug = post.data.Slug!;
const category = getCategory(post);
const dateStr = getDateIso(post);
const locked = isLocked(post);
const summary = post.data.简介 || '';
const tags = post.data.tags || [];

// Derive Chinese title from file path (last segment without extension)
const segments = post.id.replace(/\.md$/, '').split('/');
const titleZh = segments[segments.length - 1];

// Reading time estimate: ~400 Chinese chars per minute
const bodyLength = post.body?.length ?? 0;
const readingMinutes = Math.max(1, Math.ceil(bodyLength / 400));
---

<a href={`/post/${slug}/`} class="post-card">
  <div class="post-card__cover">
    <AICover category={category} title={titleZh} slug={slug} />
  </div>

  <div class="post-card__body">
    <div class="post-card__meta-top">
      {category && <span class="post-card__category">{category}</span>}
      {locked && <span class="post-card__locked" title="Locked">🔒</span>}
    </div>

    <h3 class="post-card__title">
      <span class="lang-zh">{titleZh}</span>
      <span class="lang-en">{slug}</span>
    </h3>

    {summary && (
      <p class="post-card__summary">
        <span class="lang-zh">{summary.length > 80 ? summary.slice(0, 80) + '…' : summary}</span>
        <span class="lang-en">{summary.length > 80 ? summary.slice(0, 80) + '…' : summary}</span>
      </p>
    )}

    {tags.length > 0 && (
      <div class="post-card__tags">
        {tags.slice(0, 4).map((tag) => (
          <span class="post-card__tag">{tag}</span>
        ))}
        {tags.length > 4 && <span class="post-card__tag">+{tags.length - 4}</span>}
      </div>
    )}

    <div class="post-card__footer">
      {dateStr && <span class="post-card__date">{dateStr}</span>}
      <span class="post-card__reading-time">
        <span class="lang-zh">{readingMinutes} 分钟</span>
        <span class="lang-en">{readingMinutes} min</span>
      </span>
    </div>
  </div>
</a>

<style>
  .post-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .post-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.12);
  }

  .post-card__cover {
    flex-shrink: 0;
  }

  .post-card__cover :global(.ai-cover) {
    border-radius: 0;
    border: none;
  }

  .post-card__body {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.25rem 1.25rem;
    flex: 1;
  }

  .post-card__meta-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .post-card__category {
    font-size: 0.6875rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
    background: var(--primary-soft);
    padding: 0.125rem 0.5rem;
    border-radius: 9999px;
  }

  .post-card__locked {
    font-size: 0.75rem;
  }

  .post-card__title {
    margin: 0;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__summary {
    margin: 0;
    font-size: 0.8125rem;
    color: var(--text-dim);
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.375rem;
    margin-top: auto;
  }

  .post-card__tag {
    font-size: 0.625rem;
    color: var(--text-dim);
    background: var(--bg-elevated);
    padding: 0.125rem 0.375rem;
    border-radius: 0.25rem;
    border: 1px solid var(--border);
  }

  .post-card__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.6875rem;
    color: var(--text-dim);
    margin-top: 0.5rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .post-card__date {
    font-variant-numeric: tabular-nums;
  }
</style>
