---
/**
 * PostCard — homepage card component.
 */
import { getCategory, getDateIso, getPostTitle, isLocked } from '@/lib/obsidian-parser';
import type { Post } from '@/lib/obsidian-parser';

interface Props {
  post: Post;
  translation?: Post;
}

const { post, translation } = Astro.props;

const slug = post.data.Slug!;
const category = getCategory(post);
const dateStr = getDateIso(post);
const locked = isLocked(post);
const summaryZh = post.data.简介 || '';
const summaryEn = translation?.data.简介 || '';
const titleZh = getPostTitle(post);
const showDualTitle = titleZh !== slug;
const visualSeed = [...`${slug}:${category}`].reduce((sum, char, index) => sum + char.charCodeAt(0) * (index + 1), 0);
const visualHue = 180 + (visualSeed % 150);
const visualStyle = `--post-card-hue:${visualHue}`;
---

<a
  href={`/post/${slug}/`}
  class="post-card group block overflow-hidden rounded-3xl border border-[var(--border)] bg-[var(--bg-card)] no-underline text-[var(--text)] transition-all duration-300 hover:-translate-y-1 hover:border-[var(--border-hover)] hover:shadow-[0_20px_60px_rgba(0,0,0,0.08)]"
  data-category={category}
  data-tags={(post.data.tags || []).join(',')}
  data-title={titleZh}
  data-slug={slug}
>
  <div class="post-card__visual" style={visualStyle} aria-hidden="true">
    <span class="post-card__visual-line"></span>
    <span class="post-card__visual-dot"></span>
  </div>

  <div class="p-6">
    <div class="flex items-center justify-between text-sm text-[var(--text-muted)]">
      <span class="uppercase tracking-[0.3em] text-[11px] text-zinc-500">
        {category || 'Blog'}
        {locked && <span class="ml-2 normal-case tracking-normal" title="Locked">🔒</span>}
      </span>
      <span>{dateStr || ''}</span>
    </div>

    <h3 class="mt-3 text-2xl md:text-3xl font-semibold tracking-tight m-0 line-clamp-2">
      {showDualTitle ? (
        <>
          <span class="lang-zh">{titleZh}</span>
          <span class="lang-en">{slug}</span>
        </>
      ) : (
        <span>{titleZh}</span>
      )}
    </h3>

    {(summaryZh || summaryEn) && (
      <p class="mt-3 text-[var(--text-muted)] m-0 line-clamp-2 text-sm">
        {summaryZh && <span class="lang-zh">{summaryZh.length > 100 ? summaryZh.slice(0, 100) + '…' : summaryZh}</span>}
        {summaryEn && <span class="lang-en">{summaryEn.length > 100 ? summaryEn.slice(0, 100) + '…' : summaryEn}</span>}
      </p>
    )}

    <div class="mt-6 inline-flex items-center gap-2 text-sm font-medium text-[var(--text)] transition-all group-hover:gap-4">
      <span class="lang-zh">阅读</span>
      <span class="lang-en">Read article</span>
      <span aria-hidden="true">→</span>
    </div>
  </div>
</a>

<style>
  .post-card__visual {
    position: relative;
    height: 9rem;
    overflow: hidden;
    border-bottom: 1px solid var(--border);
    background:
      radial-gradient(circle at 18% 24%, hsl(var(--post-card-hue) 84% 62% / 0.28), transparent 28%),
      radial-gradient(circle at 80% 18%, hsl(calc(var(--post-card-hue) + 42) 86% 64% / 0.18), transparent 26%),
      linear-gradient(135deg, color-mix(in srgb, var(--bg-elevated) 86%, transparent), var(--bg-card));
  }

  .post-card__visual::before {
    content: '';
    position: absolute;
    inset: 0;
    opacity: 0.34;
    background:
      linear-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.86), transparent);
  }

  .post-card__visual-line,
  .post-card__visual-dot {
    position: absolute;
    display: block;
  }

  .post-card__visual-line {
    left: 1.25rem;
    right: 1.25rem;
    bottom: 1.35rem;
    height: 1px;
    background: linear-gradient(90deg, hsl(var(--post-card-hue) 90% 65% / 0.8), transparent);
  }

  .post-card__visual-dot {
    right: 1.45rem;
    bottom: 1.1rem;
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: hsl(var(--post-card-hue) 90% 65%);
    box-shadow: 0 0 18px hsl(var(--post-card-hue) 90% 65% / 0.55);
  }

  @media (max-width: 768px) {
    .post-card__visual {
      height: 8rem;
    }
  }
</style>
