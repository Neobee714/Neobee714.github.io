---
/**
 * PostCard — card component for the homepage grid.
 * Premium minimal design: rounded-3xl, AICover, tag, title, description, "Read →".
 * Bilingual DOM with `.lang-zh` / `.lang-en` classes.
 *
 * Validates: REQ-07-2
 */
import AICover from './AICover.astro';
import { getCategory, getDateIso, isLocked } from '@/lib/obsidian-parser';
import type { Post } from '@/lib/obsidian-parser';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const slug = post.data.Slug!;
const category = getCategory(post);
const dateStr = getDateIso(post);
const locked = isLocked(post);
const summary = post.data.简介 || '';
const tags = post.data.tags || [];

// Derive Chinese title from file path (last segment without extension)
const segments = post.id.replace(/\.md$/, '').split('/');
const titleZh = segments[segments.length - 1];

// Reading time estimate: ~400 Chinese chars per minute
const bodyLength = post.body?.length ?? 0;
const readingMinutes = Math.max(1, Math.ceil(bodyLength / 400));
---

<a
  href={`/post/${slug}/`}
  class="post-card group block rounded-3xl border border-[var(--border)] bg-[var(--bg-card)] p-6 no-underline text-[var(--text)] transition-all duration-200 hover:border-[var(--border-hover)] hover:-translate-y-1 hover:shadow-xl"
  data-category={category}
  data-tags={tags.join(',')}
  data-title={titleZh}
  data-slug={slug}
>
  <AICover category={category} title={titleZh} slug={slug} />

  <div class="mt-5 flex items-center justify-between">
    <span class="text-xs uppercase tracking-[0.3em] text-zinc-500">
      {category || 'Blog'}
      {locked && <span class="ml-2" title="Locked">🔒</span>}
    </span>
    <span class="text-sm text-[var(--text-muted)]">
      {dateStr || ''}
    </span>
  </div>

  <h3 class="mt-3 text-2xl md:text-3xl font-semibold tracking-tight m-0 line-clamp-2">
    <span class="lang-zh">{titleZh}</span>
    <span class="lang-en">{slug}</span>
  </h3>

  {summary && (
    <p class="mt-3 text-[var(--text-muted)] m-0 line-clamp-2 text-sm">
      <span class="lang-zh">{summary.length > 100 ? summary.slice(0, 100) + '…' : summary}</span>
      <span class="lang-en">{summary.length > 100 ? summary.slice(0, 100) + '…' : summary}</span>
    </p>
  )}

  <div class="mt-6 flex items-center gap-2 font-medium text-[var(--text)]">
    <span class="lang-zh">阅读</span>
    <span class="lang-en">Read</span>
    <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <path d="M5 12h14"></path>
      <path d="M13 5l7 7-7 7"></path>
    </svg>
  </div>
</a>
