---
/**
 * FeaturedPost — large featured card for homepage hero area.
 * Left-right split: AICover on left, meta info on right.
 * Larger than PostCard, used for the first/featured post.
 */
import AICover from './AICover.astro';
import { getCategory, getDateIso, isLocked } from '@/lib/obsidian-parser';
import type { Post } from '@/lib/obsidian-parser';

interface Props {
  post: Post;
}

const { post } = Astro.props;

const slug = post.data.Slug!;
const category = getCategory(post);
const dateStr = getDateIso(post);
const locked = isLocked(post);
const summary = post.data.简介 || '';
const tags = post.data.tags || [];

const segments = post.id.replace(/\.md$/, '').split('/');
const titleZh = segments[segments.length - 1];

const bodyLength = post.body?.length ?? 0;
const readingMinutes = Math.max(1, Math.ceil(bodyLength / 400));
---

<a href={`/post/${slug}/`} class="featured-post">
  <div class="featured-post__cover">
    <AICover category={category} title={titleZh} slug={slug} />
  </div>

  <div class="featured-post__body">
    <div class="featured-post__meta-top">
      {category && <span class="featured-post__category">{category}</span>}
      {locked && <span class="featured-post__locked" title="Locked">🔒</span>}
    </div>

    <h2 class="featured-post__title">
      <span class="lang-zh">{titleZh}</span>
      <span class="lang-en">{slug}</span>
    </h2>

    {summary && (
      <p class="featured-post__summary">
        <span class="lang-zh">{summary.length > 150 ? summary.slice(0, 150) + '…' : summary}</span>
        <span class="lang-en">{summary.length > 150 ? summary.slice(0, 150) + '…' : summary}</span>
      </p>
    )}

    {tags.length > 0 && (
      <div class="featured-post__tags">
        {tags.slice(0, 6).map((tag) => (
          <span class="featured-post__tag">{tag}</span>
        ))}
        {tags.length > 6 && <span class="featured-post__tag">+{tags.length - 6}</span>}
      </div>
    )}

    <div class="featured-post__footer">
      {dateStr && <span class="featured-post__date">{dateStr}</span>}
      <span class="featured-post__reading-time">
        <span class="lang-zh">{readingMinutes} 分钟</span>
        <span class="lang-en">{readingMinutes} min</span>
      </span>
    </div>
  </div>
</a>

<style>
  .featured-post {
    display: flex;
    flex-direction: row;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 1rem;
    overflow: hidden;
    text-decoration: none;
    color: var(--text);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .featured-post:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.15);
  }

  .featured-post__cover {
    flex: 0 0 45%;
    min-height: 280px;
  }

  .featured-post__cover :global(.ai-cover) {
    border-radius: 0;
    border: none;
    height: 100%;
    aspect-ratio: unset;
  }

  .featured-post__body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: 1.5rem 2rem;
    flex: 1;
    justify-content: center;
  }

  .featured-post__meta-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  .featured-post__category {
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--primary);
    background: var(--primary-soft);
    padding: 0.2rem 0.625rem;
    border-radius: 9999px;
  }

  .featured-post__locked {
    font-size: 0.875rem;
  }

  .featured-post__title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .featured-post__summary {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .featured-post__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .featured-post__tag {
    font-size: 0.6875rem;
    color: var(--text-dim);
    background: var(--bg-elevated);
    padding: 0.2rem 0.5rem;
    border-radius: 0.25rem;
    border: 1px solid var(--border);
  }

  .featured-post__footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--text-dim);
    margin-top: 0.5rem;
    padding-top: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .featured-post__date {
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 768px) {
    .featured-post {
      flex-direction: column;
    }
    .featured-post__cover {
      flex: none;
      min-height: 200px;
    }
  }
</style>
