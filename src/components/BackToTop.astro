---
/**
 * BackToTop — floating button that appears on scroll > 400px.
 * Smooth scrolls to top on click. Inline SVG arrow icon.
 */
---

<button
  id="back-to-top"
  type="button"
  class="back-to-top"
  aria-label="Back to top"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <path d="M18 15l-6-6-6 6" />
  </svg>
</button>

<style>
  .back-to-top {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    width: 2.5rem;
    height: 2.5rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 50%;
    color: var(--text);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.2s ease, visibility 0.2s ease, transform 0.15s ease;
    z-index: 100;
  }

  .back-to-top.visible {
    opacity: 1;
    visibility: visible;
  }

  .back-to-top:hover {
    transform: translateY(-2px);
    border-color: var(--primary);
    color: var(--primary);
  }
</style>

<script>
  const backToTopState = ((window as Window & typeof globalThis & {
    __blogBackToTop?: {
      scrollBound: boolean;
      afterSwapBound: boolean;
    };
  }).__blogBackToTop ??= {
    scrollBound: false,
    afterSwapBound: false,
  });

  function toggleBackToTopVisibility() {
    const btn = document.getElementById('back-to-top');
    btn?.classList.toggle('visible', window.scrollY > 400);
  }

  function initBackToTop() {
    const btn = document.getElementById('back-to-top');
    if (!btn) return;

    if (!backToTopState.scrollBound) {
      window.addEventListener('scroll', toggleBackToTopVisibility, { passive: true });
      backToTopState.scrollBound = true;
    }

    toggleBackToTopVisibility();

    if (!btn.dataset.backToTopBound) {
      btn.addEventListener('click', () => {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      });
      btn.dataset.backToTopBound = 'true';
    }
  }

  const shouldInitBackToTop = !backToTopState.afterSwapBound;
  if (!backToTopState.afterSwapBound) {
    document.addEventListener('astro:after-swap', initBackToTop);
    backToTopState.afterSwapBound = true;
  }
  if (shouldInitBackToTop) {
    initBackToTop();
  }
</script>
