---
/**
 * ReadingProgress — fixed top bar showing scroll progress.
 * Uses accent color (cyan-500).
 */
---

<div class="reading-progress" id="reading-progress" aria-hidden="true"></div>

<style>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    height: 1px;
    width: 0%;
    background: var(--accent);
    z-index: 9999;
    transition: width 0.1s linear;
    pointer-events: none;
  }
</style>

<script>
  const readingProgressState = ((window as Window & typeof globalThis & {
    __blogReadingProgress?: {
      scrollBound: boolean;
      afterSwapBound: boolean;
    };
  }).__blogReadingProgress ??= {
    scrollBound: false,
    afterSwapBound: false,
  });

  function updateReadingProgress() {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;

    const scrollTop = window.scrollY;
    const docHeight = document.documentElement.scrollHeight - window.innerHeight;
    const progress = docHeight > 0 ? (scrollTop / docHeight) * 100 : 0;
    bar.style.width = `${Math.min(100, progress)}%`;
  }

  function initReadingProgress() {
    const bar = document.getElementById('reading-progress');
    if (!bar) return;

    if (!readingProgressState.scrollBound) {
      window.addEventListener('scroll', updateReadingProgress, { passive: true });
      readingProgressState.scrollBound = true;
    }

    updateReadingProgress();
  }

  const shouldInitReadingProgress = !readingProgressState.afterSwapBound;
  if (!readingProgressState.afterSwapBound) {
    document.addEventListener('astro:after-swap', initReadingProgress);
    readingProgressState.afterSwapBound = true;
  }
  if (shouldInitReadingProgress) {
    initReadingProgress();
  }
</script>
