---
/**
 * TableOfContents — sticky sidebar TOC for article pages.
 * Renders h1-h3 as a nested list.
 * Client-side IntersectionObserver highlights current section.
 */
interface Props {
  headings: { depth: number; slug: string; text: string }[];
  headingsEn?: { depth: number; slug: string; text: string }[];
}

const { headings, headingsEn = [] } = Astro.props;

// Only show h1-h3
const filtered = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
const filteredEn = headingsEn.filter((h) => h.depth >= 1 && h.depth <= 3);
---

{filtered.length > 0 && (
  <nav class="toc" aria-label="Table of Contents">
    <h4 class="toc__title">
      <span class="lang-zh">目录</span>
      <span class="lang-en">Contents</span>
    </h4>
    <ul class="toc__list lang-zh">
      {filtered.map((heading) => (
        <li class={`toc__item toc__item--depth-${heading.depth}`}>
          <a href={`#${heading.slug}`} class="toc__link" data-toc-slug={heading.slug}>
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
    <ul class="toc__list lang-en">
      {(filteredEn.length > 0 ? filteredEn : filtered).map((heading) => (
        <li class={`toc__item toc__item--depth-${heading.depth}`}>
          <a href={`#${heading.slug}`} class="toc__link" data-toc-slug={heading.slug}>
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    padding: 0;
  }

  .toc__title {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-muted);
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc__item {
    margin: 0;
  }

  .toc__item--depth-2 {
    padding-left: 0.75rem;
  }

  .toc__item--depth-3 {
    padding-left: 1.5rem;
  }

  .toc__link {
    display: block;
    padding: 0.25rem 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
    line-height: 1.5;
  }

  .toc__link:hover {
    color: var(--text);
  }

  .toc__link.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }
</style>

<script>
  function initTOC() {
    document.querySelectorAll<HTMLElement>('.toc').forEach((toc) => {
      const links = toc.querySelectorAll<HTMLAnchorElement>('[data-toc-slug]');
      if (!links.length) return;

      const uniqueSlugs = [...new Set(Array.from(links).map((l) => l.dataset.tocSlug!).filter(Boolean))];
      const headingEls = uniqueSlugs
        .map((slug) => document.getElementById(slug))
        .filter(Boolean) as HTMLElement[];

      if (!headingEls.length) return;

      let currentSlug = window.location.hash ? window.location.hash.slice(1) : uniqueSlugs[0];

      const updateActive = () => {
        links.forEach((link) => {
          link.classList.toggle('active', link.dataset.tocSlug === currentSlug);
        });
      };

      updateActive();

      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries
            .filter((entry) => entry.isIntersecting)
            .sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
          if (visible[0]) {
            currentSlug = visible[0].target.id;
            updateActive();
          }
        },
        { rootMargin: '-80px 0px -60% 0px', threshold: [0, 0.1, 0.25, 0.5, 1] }
      );

      headingEls.forEach((el) => observer.observe(el));

      window.addEventListener('hashchange', () => {
        const next = window.location.hash.slice(1);
        if (!next) return;
        currentSlug = next;
        updateActive();
      });
    });
  }

  // Run on initial load and after Astro page transitions
  initTOC();
  document.addEventListener('astro:after-swap', initTOC);
</script>
