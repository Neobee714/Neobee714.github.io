---
/**
 * TableOfContents — sticky sidebar TOC for article pages.
 * Renders h1-h3 as a nested list.
 * Client-side IntersectionObserver highlights current section.
 */
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}

const { headings } = Astro.props;

// Only show h1-h3
const filtered = headings.filter((h) => h.depth >= 1 && h.depth <= 3);
---

{filtered.length > 0 && (
  <nav class="toc" aria-label="Table of Contents">
    <h4 class="toc__title">
      <span class="lang-zh">目录</span>
      <span class="lang-en">Contents</span>
    </h4>
    <ul class="toc__list">
      {filtered.map((heading) => (
        <li class={`toc__item toc__item--depth-${heading.depth}`}>
          <a href={`#${heading.slug}`} class="toc__link" data-toc-slug={heading.slug}>
            {heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    padding: 0;
  }

  .toc__title {
    margin: 0 0 0.75rem;
    font-size: 0.6875rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-muted);
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc__item {
    margin: 0;
  }

  .toc__item--depth-2 {
    padding-left: 0.75rem;
  }

  .toc__item--depth-3 {
    padding-left: 1.5rem;
  }

  .toc__link {
    display: block;
    padding: 0.25rem 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
    line-height: 1.5;
  }

  .toc__link:hover {
    color: var(--text);
  }

  .toc__link.active {
    color: var(--accent);
    border-left-color: var(--accent);
  }
</style>

<script>
  function initTOC() {
    const links = document.querySelectorAll<HTMLAnchorElement>('[data-toc-slug]');
    if (!links.length) return;

    const slugs = Array.from(links).map((l) => l.dataset.tocSlug!);
    const headingEls = slugs
      .map((slug) => document.getElementById(slug))
      .filter(Boolean) as HTMLElement[];

    if (!headingEls.length) return;

    let currentSlug = slugs[0];

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            currentSlug = entry.target.id;
            break;
          }
        }
        links.forEach((link) => {
          link.classList.toggle('active', link.dataset.tocSlug === currentSlug);
        });
      },
      { rootMargin: '-80px 0px -60% 0px', threshold: 0 }
    );

    headingEls.forEach((el) => observer.observe(el));
  }

  // Run on initial load and after Astro page transitions
  initTOC();
  document.addEventListener('astro:after-swap', initTOC);
</script>
