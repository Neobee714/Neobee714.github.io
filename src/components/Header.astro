---
/**
 * Header — minimal site header.
 * Brand "Xyvora" on left, theme toggle + lang toggle on right.
 * Backdrop blur with semi-transparent background.
 */
import ThemeToggle from './ThemeToggle.astro';
import LangToggle from './LangToggle.astro';
---

<header class="sticky top-0 z-50 backdrop-blur-xl border-b border-[var(--border)]" style="background: color-mix(in srgb, var(--bg) 75%, transparent);">
  <div class="max-w-6xl mx-auto px-6 py-4 flex justify-between items-center">
    <a href="/" class="text-xl font-semibold text-[var(--text)] no-underline">Xyvora</a>
    <div class="flex items-center gap-1">
      <ThemeToggle />
      <LangToggle />
    </div>
  </div>
</header>
