---
/**
 * SearchModal — Ctrl+K / ⌘+K opens a search modal.
 * Loads Fuse.js and searches against /search-index.json.
 * ESC or backdrop click closes.
 */
---

<div id="search-modal" class="search-modal" aria-hidden="true">
  <div class="search-modal__backdrop"></div>
  <div class="search-modal__dialog" role="dialog" aria-label="Search">
    <div class="search-modal__input-wrap">
      <svg class="search-modal__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8" />
        <path d="M21 21l-4.35-4.35" />
      </svg>
      <input
        id="search-input"
        type="text"
        class="search-modal__input"
        placeholder="搜索文章… / Search posts…"
        autocomplete="off"
      />
      <kbd class="search-modal__kbd">ESC</kbd>
    </div>
    <div id="search-results" class="search-modal__results"></div>
  </div>
</div>

<style>
  .search-modal {
    position: fixed;
    inset: 0;
    z-index: 9000;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-top: 15vh;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.15s ease, visibility 0.15s ease;
  }

  .search-modal.open {
    opacity: 1;
    visibility: visible;
  }

  .search-modal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.5);
    backdrop-filter: blur(4px);
  }

  .search-modal__dialog {
    position: relative;
    width: 100%;
    max-width: 560px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    overflow: hidden;
    box-shadow: 0 16px 48px rgba(0, 0, 0, 0.2);
  }

  .search-modal__input-wrap {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.875rem 1rem;
    border-bottom: 1px solid var(--border);
  }

  .search-modal__icon {
    flex-shrink: 0;
    color: var(--text-dim);
  }

  .search-modal__input {
    flex: 1;
    background: transparent;
    border: none;
    outline: none;
    font-size: 0.9375rem;
    color: var(--text);
  }

  .search-modal__input::placeholder {
    color: var(--text-dim);
  }

  .search-modal__kbd {
    font-size: 0.625rem;
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--border);
    border-radius: 0.25rem;
    color: var(--text-dim);
    background: var(--bg-card);
  }

  .search-modal__results {
    max-height: 360px;
    overflow-y: auto;
    padding: 0.5rem;
  }

  .search-modal__results:empty {
    display: none;
  }
</style>

<style is:global>
  .search-result-item {
    display: block;
    padding: 0.625rem 0.75rem;
    border-radius: 0.5rem;
    text-decoration: none;
    color: var(--text);
    transition: background 0.1s ease;
  }

  .search-result-item:hover {
    background: var(--primary-soft);
  }

  .search-result-item__title {
    font-size: 0.875rem;
    font-weight: 500;
    margin: 0;
  }

  .search-result-item__meta {
    font-size: 0.6875rem;
    color: var(--text-dim);
    margin-top: 0.125rem;
  }
</style>

<script>
  let fuseInstance: any = null;
  let searchData: any[] = [];

  async function loadSearchIndex() {
    if (searchData.length) return;
    try {
      const res = await fetch('/search-index.json');
      searchData = await res.json();
      const Fuse = (await import('fuse.js')).default;
      fuseInstance = new Fuse(searchData, {
        keys: ['titleZh', 'slug', 'category', 'tags', 'summary'],
        threshold: 0.4,
      });
    } catch (err) {
      console.warn('[SearchModal] Failed to load search index:', err);
    }
  }

  function openSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement;
    if (!modal) return;
    modal.classList.add('open');
    modal.setAttribute('aria-hidden', 'false');
    input?.focus();
    loadSearchIndex();
  }

  function closeSearch() {
    const modal = document.getElementById('search-modal');
    const input = document.getElementById('search-input') as HTMLInputElement;
    const results = document.getElementById('search-results');
    if (!modal) return;
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    if (input) input.value = '';
    if (results) results.innerHTML = '';
  }

  function renderResults(query: string) {
    const results = document.getElementById('search-results');
    if (!results || !fuseInstance) return;

    if (!query.trim()) {
      results.innerHTML = '';
      return;
    }

    const matches = fuseInstance.search(query).slice(0, 8);
    results.innerHTML = matches
      .map(({ item }: any) => `
        <a href="/post/${item.slug}/" class="search-result-item">
          <p class="search-result-item__title">${item.titleZh}</p>
          <p class="search-result-item__meta">${item.category || 'Blog'} · ${item.slug}</p>
        </a>
      `)
      .join('');
  }

  function initSearch() {
    // Keyboard shortcut
    document.addEventListener('keydown', (e) => {
      if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
        e.preventDefault();
        const modal = document.getElementById('search-modal');
        if (modal?.classList.contains('open')) {
          closeSearch();
        } else {
          openSearch();
        }
      }
      if (e.key === 'Escape') {
        closeSearch();
      }
    });

    // Backdrop click
    document.querySelector('.search-modal__backdrop')?.addEventListener('click', closeSearch);

    // Input handler
    document.getElementById('search-input')?.addEventListener('input', (e) => {
      renderResults((e.target as HTMLInputElement).value);
    });
  }

  initSearch();
  document.addEventListener('astro:after-swap', initSearch);
</script>
