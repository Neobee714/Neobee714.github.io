---
/**
 * LockedBanner — terminal-style "ACCESS DENIED" banner.
 * Shown instead of article content for locked posts.
 * Includes a blinking cursor effect.
 */
---

<div class="locked-banner">
  <div class="locked-banner__terminal">
    <div class="locked-banner__header">
      <span class="locked-banner__dot locked-banner__dot--red"></span>
      <span class="locked-banner__dot locked-banner__dot--yellow"></span>
      <span class="locked-banner__dot locked-banner__dot--green"></span>
    </div>
    <div class="locked-banner__body">
      <p class="locked-banner__line">$ cat article.md</p>
      <p class="locked-banner__line locked-banner__error">[错误] 访问被拒绝 — ACCESS DENIED</p>
      <p class="locked-banner__line">此文章已锁定，内容暂不公开。</p>
      <p class="locked-banner__line">如需访问，请联系作者。</p>
      <p class="locked-banner__line locked-banner__prompt">
        $<span class="locked-banner__cursor">█</span>
      </p>
    </div>
  </div>
</div>

<style>
  .locked-banner {
    display: flex;
    justify-content: center;
    padding: 3rem 1rem;
  }

  .locked-banner__terminal {
    width: 100%;
    max-width: 600px;
    background: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    overflow: hidden;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }

  .locked-banner__header {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1rem;
    background: #161b22;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .locked-banner__dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
  }

  .locked-banner__dot--red { background: #ff5f57; }
  .locked-banner__dot--yellow { background: #febc2e; }
  .locked-banner__dot--green { background: #28c840; }

  .locked-banner__body {
    padding: 1.5rem;
  }

  .locked-banner__line {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    color: #10b981;
    line-height: 1.8;
  }

  .locked-banner__error {
    color: #ef4444;
    font-weight: 600;
  }

  .locked-banner__prompt {
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .locked-banner__cursor {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
