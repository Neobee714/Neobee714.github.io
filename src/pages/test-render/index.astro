---
import { getPublishedPosts } from '@/lib/obsidian-parser';
const posts = (await getPublishedPosts()).slice(0, 3);
---

<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>Phase 3 · test renders</title>
  </head>
  <body style="font-family: ui-sans-serif, system-ui; padding: 2rem;">
    <h1>Rendered samples</h1>
    <ul>
      {posts.map((p) => (
        <li><a href={`/test-render/${p.data.Slug}/`}>{p.data.Slug}</a></li>
      ))}
    </ul>
  </body>
</html>
