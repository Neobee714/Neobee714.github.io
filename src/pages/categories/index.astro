---
/**
 * Categories index — all categories sorted by post count, displayed as pills.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getPublishedPosts, getCategory } from '@/lib/obsidian-parser';

const posts = await getPublishedPosts();

// Count categories
const catCounts = new Map<string, number>();
for (const post of posts) {
  const cat = getCategory(post) || 'uncategorized';
  catCounts.set(cat, (catCounts.get(cat) || 0) + 1);
}

// Sort by count descending
const sortedCats = [...catCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<BaseLayout title="分类 - Xyvora" description="All categories">
  <div class="categories-page">
    <h1 class="categories-page__title">
      <span class="lang-zh">分类</span>
      <span class="lang-en">Categories</span>
    </h1>

    {sortedCats.length > 0 ? (
      <div class="categories-page__cloud">
        {sortedCats.map(([cat, count]) => (
          <a href={`/categories/${encodeURIComponent(cat)}/`} class="categories-page__pill">
            {cat} <span class="categories-page__count">{count}</span>
          </a>
        ))}
      </div>
    ) : (
      <p class="categories-page__empty">
        <span class="lang-zh">暂无分类</span>
        <span class="lang-en">No categories yet</span>
      </p>
    )}
  </div>
</BaseLayout>

<style>
  .categories-page {
    max-width: 780px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
  }

  .categories-page__title {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 2rem;
  }

  .categories-page__cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .categories-page__pill {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 9999px;
    font-size: 0.875rem;
    color: var(--text);
    text-decoration: none;
    transition: border-color 0.15s ease, color 0.15s ease;
  }

  .categories-page__pill:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  .categories-page__count {
    font-size: 0.6875rem;
    color: var(--text-dim);
    background: var(--bg-elevated);
    padding: 0.0625rem 0.375rem;
    border-radius: 9999px;
  }

  .categories-page__empty {
    color: var(--text-dim);
    text-align: center;
    padding: 3rem 0;
  }
</style>
