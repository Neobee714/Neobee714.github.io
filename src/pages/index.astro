---
/**
 * Homepage — landing page with the refined blog layout.
 * Keeps the existing data flow and card component usage.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SearchModal from '@/components/SearchModal.astro';
import PostCard from '@/components/PostCard.astro';
import { getCategory, getPublishedPosts } from '@/lib/obsidian-parser';

const posts = await getPublishedPosts();

const allCategories = [...new Set(posts.map((p) => getCategory(p)).filter(Boolean))];
---

<BaseLayout title="Xyvora - Web Security & CTF Notes">
  <SearchModal />

  <section class="max-w-6xl mx-auto px-6 pt-24 pb-18 relative">
    <div class="hero-glow hero-glow--violet"></div>
    <div class="hero-glow hero-glow--cyan"></div>

    <div class="relative z-10 max-w-4xl">
      <div class="hero-badge">
        <div class="hero-badge__dot"></div>
        Security Research Journal
      </div>

      <h1 class="mt-8 text-6xl md:text-8xl font-semibold tracking-tight leading-none text-[var(--text)]">Xyvora</h1>

      <p class="mt-8 text-xl max-w-2xl leading-relaxed text-[var(--text-muted)]">
        <span class="lang-zh">Web Security / Active Directory / CTF / Research Notes. 一个偏向现代研究感与工程感的安全博客。</span>
        <span class="lang-en">Web Security / Active Directory / CTF / Research Notes.</span>
      </p>

      <div class="max-w-xl mt-12 relative">
        <svg class="absolute left-4 top-4 w-5 h-5 text-zinc-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="11" cy="11" r="7"></circle>
          <path d="M20 20l-3.5-3.5"></path>
        </svg>
        <input
          id="homepage-search"
          type="text"
          class="w-full pl-11 pr-4 py-4 rounded-2xl border border-[var(--border)] bg-[var(--bg-card)] text-[var(--text)] placeholder:text-[var(--text-muted)] focus:outline-none focus:border-[var(--border-hover)] transition-colors"
          placeholder="Search articles, CVEs, writeups..."
        />
      </div>

      {allCategories.length > 0 && (
        <div class="flex flex-wrap gap-3 mt-10" id="tag-filters">
          <button
            class="filter-pill px-4 py-2 rounded-xl border border-[var(--border)] text-sm text-white bg-zinc-800 cursor-pointer transition-colors"
            data-filter="all"
          >
            All
          </button>
          {allCategories.map((cat) => (
            <button
              class="filter-pill px-4 py-2 rounded-xl border border-[var(--border)] text-sm text-[var(--text)] bg-[var(--bg-card)] cursor-pointer transition-colors hover:border-[var(--border-hover)]"
              data-filter={cat}
            >
              {cat}
            </button>
          ))}
        </div>
      )}
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-6 pb-8">
    <div class="flex items-center justify-between mb-8 gap-6">
      <div>
        <h2 class="text-2xl font-semibold text-[var(--text)]">Latest Research</h2>
        <p class="text-[var(--text-muted)] mt-2">
          <span class="lang-zh">最新渗透测试与漏洞研究记录</span>
          <span class="lang-en">Latest notes from research, labs, and writeups.</span>
        </p>
      </div>

      <div class="hidden md:flex items-center gap-3 text-sm text-[var(--text-muted)]">
        <div class="hero-badge__dot"></div>
        Updated Weekly
      </div>
    </div>

    <div class="grid lg:grid-cols-3 md:grid-cols-2 gap-6 pb-16" id="posts-grid">
      {posts.map((post, i) => (
        <div class="card-animate" style={`--delay: ${i * 0.04}s`}>
          <PostCard post={post} />
        </div>
      ))}
    </div>
  </section>

  {posts.length === 0 && (
    <div class="max-w-6xl mx-auto px-6 text-center py-16 text-[var(--text-muted)]">
      <p class="lang-zh">暂无文章</p>
      <p class="lang-en">No posts yet</p>
    </div>
  )}
</BaseLayout>

<script>
  function initHomepageFilters() {
    const searchInput = document.getElementById('homepage-search') as HTMLInputElement | null;
    const grid = document.getElementById('posts-grid');
    const pills = document.querySelectorAll<HTMLButtonElement>('.filter-pill');
    if (!grid) return;

    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.card-animate'));
    let activeFilter = 'all';

    function filterCards() {
      const query = (searchInput?.value || '').toLowerCase();
      cards.forEach((wrapper) => {
        const card = wrapper.querySelector('.post-card') as HTMLElement | null;
        if (!card) return;
        const title = (card.dataset.title || '').toLowerCase();
        const slug = (card.dataset.slug || '').toLowerCase();
        const category = (card.dataset.category || '').toLowerCase();
        const tags = (card.dataset.tags || '').toLowerCase();

        const matchesSearch = !query || title.includes(query) || slug.includes(query) || tags.includes(query);
        const matchesFilter = activeFilter === 'all' || category === activeFilter.toLowerCase();

        wrapper.style.display = matchesSearch && matchesFilter ? '' : 'none';
      });
    }

    searchInput?.addEventListener('input', filterCards);

    pills.forEach((pill) => {
      pill.addEventListener('click', () => {
        activeFilter = pill.dataset.filter || 'all';
        pills.forEach((p) => {
          p.classList.toggle('bg-zinc-800', p === pill);
          p.classList.toggle('text-white', p === pill);
        });
        filterCards();
      });
    });

    // Activate "All" pill by default
    const allPill = document.querySelector('[data-filter="all"]') as HTMLButtonElement | null;
    if (allPill) {
      allPill.classList.add('bg-zinc-800', 'text-white');
    }
  }

  initHomepageFilters();
  document.addEventListener('astro:after-swap', initHomepageFilters);
</script>

<style>
  @keyframes card-up {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .card-animate {
    opacity: 0;
    animation: card-up 0.4s ease forwards;
    animation-delay: var(--delay, 0s);
  }

  .hero-glow {
    position: absolute;
    border-radius: 999px;
    pointer-events: none;
    filter: blur(120px);
    opacity: 0.7;
  }

  .hero-glow--violet {
    top: 0;
    right: 0;
    width: 32rem;
    height: 32rem;
    background: rgba(139, 92, 246, 0.12);
  }

  .hero-glow--cyan {
    top: 5rem;
    left: 3rem;
    width: 20rem;
    height: 20rem;
    background: rgba(6, 182, 212, 0.12);
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    padding: 0.65rem 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: color-mix(in srgb, var(--bg-card) 88%, transparent);
    color: var(--text-muted);
    backdrop-filter: blur(18px);
    font-size: 0.875rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.04);
  }

  .hero-badge__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: linear-gradient(135deg, #34d399, #22c55e);
    box-shadow: 0 0 20px rgba(52, 211, 153, 0.9);
    flex: none;
  }
</style>
