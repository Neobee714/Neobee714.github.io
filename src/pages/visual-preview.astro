  <script>
    const visualPreviewRevealState = ((window as Window & typeof globalThis & {
      __blogVisualPreviewReveal?: {
        cleanup: () => void;
        afterSwapBound: boolean;
      };
    }).__blogVisualPreviewReveal ??= {
      cleanup: () => {},
      afterSwapBound: false,
    });

    function initPreviewReveal() {
      visualPreviewRevealState.cleanup();
      const sections = Array.from(document.querySelectorAll('[data-reveal]'));
      if (!sections.length) {
        visualPreviewRevealState.cleanup = () => {};
        return;
      }

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (reduceMotion) {
        sections.forEach((section) => section.classList.add('is-visible'));
        visualPreviewRevealState.cleanup = () => {};
        return;
      }

      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add('is-visible');
            }
          });
        },
        {
          threshold: 0.12,
          rootMargin: '0px 0px -8% 0px',
        }
      );

      sections.forEach((section) => observer.observe(section));
      visualPreviewRevealState.cleanup = () => {
        observer.disconnect();
        visualPreviewRevealState.cleanup = () => {};
      };
    }

    const shouldInitPreviewReveal = !visualPreviewRevealState.afterSwapBound;
    if (!visualPreviewRevealState.afterSwapBound) {
      document.addEventListener('astro:after-swap', initPreviewReveal);
      visualPreviewRevealState.afterSwapBound = true;
    }
    if (shouldInitPreviewReveal) {
      initPreviewReveal();
    }
  </script>
</PreviewLayout>
