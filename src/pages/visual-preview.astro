---
import PreviewLayout from '@/layouts/PreviewLayout.astro';

const featuredTags = ['Web', 'SSRF', 'Cloud', 'Recon'];
const recentPosts = [
  {
    index: '01',
    category: 'Research',
    titleZh: '从一条回显异常到 SSRF 内网漫游',
    titleEn: 'SSRF Pivoting From a Single Error Surface',
    textZh: '把原本零散的观察整合成可复用的排查链路，强调入口指纹、出网行为与凭据痕迹的交叉判断。',
    textEn: 'A structured workflow for turning one noisy endpoint into a repeatable internal pivot path.',
  },
  {
    index: '02',
    category: 'Active Directory',
    titleZh: '低噪声权限提升路径整理',
    titleEn: 'Low-Noise Escalation Mapping',
    textZh: '重点不是工具堆叠，而是如何在最少交互下验证假设、缩小面并留下干净的操作记录。',
    textEn: 'Focused on validation discipline, smaller blast radius, and cleaner operator traces.',
  },
  {
    index: '03',
    category: 'CTF',
    titleZh: '一类模板注入题的统一拆解方式',
    titleEn: 'A Consistent Templating Exploit Method',
    textZh: '把 payload 试错过程抽象成环境识别、语法约束、执行面确认三个稳定步骤。',
    textEn: 'Turned trial-and-error payload work into a repeatable three-step exploitation model.',
  },
];

const archiveGroups = [
  {
    label: '2026 / 05',
    items: ['HTB Helix Writeup', 'Kerberos Delegation Notes', 'Bug Bounty Recon Log'],
  },
  {
    label: '2026 / 04',
    items: ['JWT Trust Boundary Review', 'Windows Token Abuse Cheat Sheet'],
  },
];
---

<PreviewLayout title="Xyvora Visual Preview" description="Standalone redesign preview for Xyvora">
  <main class="vp-page">
    <header class="vp-topbar">
      <div class="vp-shell vp-topbar__inner">
        <a href="#vp-home" class="vp-brand">
          <span class="vp-brand__badge">
            <img src="/preview-logo-mark.png" alt="" aria-hidden="true" class="vp-brand__mark" />
          </span>
          <span class="vp-brand__wording">
            <strong>Xyvora</strong>
            <span class="vp-brand__text">Research Index</span>
          </span>
        </a>
        <nav class="vp-nav" aria-label="Preview navigation">
          <a href="#vp-home">Home</a>
          <a href="#vp-article">Article</a>
          <a href="#vp-archive">Archive</a>
          <a href="#vp-about">About</a>
        </nav>
        <div class="vp-controls">
          <span>ZH / EN</span>
          <span>Dark Lab</span>
        </div>
      </div>
    </header>

    <section id="vp-home" class="vp-hero vp-shell">
      <div class="vp-hero__intro">
        <p class="vp-kicker">Security research notebook, rebuilt as an editorial lab.</p>
        <h1>
          把安全博客从“文章列表”
          <br />
          升级成一份有判断力的研究刊物。
        </h1>
        <p class="vp-lead">
          这版预览把整站视觉统一到一个方向上：更像研究台、更像出版物、也更像你自己的站，而不是通用的技术博客皮肤。
        </p>
        <div class="vp-hero__actions">
          <a class="vp-button vp-button--primary" href="#vp-article">查看文章页样板</a>
          <a class="vp-button" href="#vp-archive">查看列表与归档</a>
        </div>
      </div>

      <aside class="vp-status">
        <div class="vp-status__card">
          <div class="vp-status__label">Current Direction</div>
          <div class="vp-status__value">Editorial / Lab / Research</div>
        </div>
        <div class="vp-status__grid">
          <div class="vp-metric">
            <span class="vp-metric__label">Tone</span>
            <strong>Calm, precise</strong>
          </div>
          <div class="vp-metric">
            <span class="vp-metric__label">Color</span>
            <strong>Bone / Ink / Rust / Cyan</strong>
          </div>
          <div class="vp-metric">
            <span class="vp-metric__label">Type</span>
            <strong>Space Grotesk + IBM Plex</strong>
          </div>
          <div class="vp-metric">
            <span class="vp-metric__label">Intent</span>
            <strong>Readable, memorable</strong>
          </div>
        </div>
      </aside>
    </section>

    <section class="vp-shell vp-featured">
      <div class="vp-section-head">
        <div>
          <p>Featured template</p>
          <h2>首页重点文章卡</h2>
        </div>
        <span>Designed to feel like a lead story, not a generic card.</span>
      </div>

      <article class="vp-feature-card">
        <div class="vp-feature-card__visual">
          <div class="vp-feature-card__stamp">Field Note 07</div>
          <div class="vp-feature-card__grid"></div>
          <div class="vp-feature-card__signal"></div>
        </div>
        <div class="vp-feature-card__body">
          <p class="vp-feature-card__meta">Research / 2026-05-28 / 11 min read</p>
          <h3>从错误处理到云边界穿透：一次 SSRF 利用链的重构</h3>
          <p class="vp-feature-card__summary">
            重点不再是“卡片多炫”，而是让首页第一屏就表达出内容密度、研究气质与作者判断。主卡在这套方案里承担的是封面故事，而不是普通文章放大版。
          </p>
          <div class="vp-tag-row">
            {featuredTags.map((tag) => <span>{tag}</span>)}
          </div>
        </div>
      </article>
    </section>

    <section class="vp-shell vp-grid-section">
      <div class="vp-section-head">
        <div>
          <p>Recent entries</p>
          <h2>统一后的文章列表卡</h2>
        </div>
        <span>Less decorative noise, stronger information hierarchy.</span>
      </div>

      <div class="vp-card-grid">
        {recentPosts.map((post) => (
          <article class="vp-post-card">
            <div class="vp-post-card__top">
              <span class="vp-post-card__index">{post.index}</span>
              <span class="vp-post-card__category">{post.category}</span>
            </div>
            <h3>
              <span class="lang-zh">{post.titleZh}</span>
              <span class="lang-en">{post.titleEn}</span>
            </h3>
            <p class="lang-zh">{post.textZh}</p>
            <p class="lang-en">{post.textEn}</p>
            <div class="vp-post-card__foot">Read dossier</div>
          </article>
        ))}
      </div>
    </section>

    <section id="vp-article" class="vp-shell vp-article-preview">
      <div class="vp-section-head">
        <div>
          <p>Article page</p>
          <h2>文章页改成“研究文档”体验</h2>
        </div>
        <span>Headline pacing, metadata blocks, side notes and a more deliberate reading surface.</span>
      </div>

      <div class="vp-article-frame">
        <aside class="vp-article-frame__rail">
          <div class="vp-rail-box vp-reveal__item" data-reveal-item>
            <div class="vp-rail-box__title">On this page</div>
            <a href="#a1">01 / Entry Point</a>
            <a href="#a2">02 / Signal Review</a>
            <a href="#a3">03 / Pivot Path</a>
            <a href="#a4">04 / Takeaways</a>
          </div>
          <div class="vp-rail-box vp-reveal__item" data-reveal-item>
            <div class="vp-rail-box__title">Case File</div>
            <span>Target: SaaS asset</span>
            <span>Vector: SSRF</span>
            <span>Noise: low</span>
          </div>
        </aside>

        <article class="vp-article">
          <p class="vp-article__eyebrow">Research dossier / Web / 2026-05-28</p>
          <h3>从一条“无害回显”到内网服务指纹：SSRF 文章页样板</h3>
          <p class="vp-article__dek">
            文章页的目标不是增加效果，而是通过更清晰的排版节奏，把“观察、判断、步骤、结论”这类研究内容自然地组织出来。
          </p>

          <div class="vp-article__meta">
            <span>Author: Xyvora</span>
            <span>Read time: 11 min</span>
            <span>Status: Published</span>
          </div>

          <section id="a1">
            <h4>01. Entry Point</h4>
            <p>
              这套视觉会把摘要、正文、侧栏信息区分得更明显。正文不再漂在大面积背景上，而是进入一个更稳定的阅读容器里，让长文显得更可信、更像技术档案。
            </p>
            <blockquote>
              在这版里，引用和结论块不只靠左边一条线，而是变成明显的侧注模块。
            </blockquote>
          </section>

          <section id="a2">
            <h4>02. Signal Review</h4>
            <p>
              标题使用更强的节奏，二级标题与正文宽度有更稳定的比例，代码区、提示区、表格区会采用统一的边框和底色语言，而不是彼此像不同主题下的组件。
            </p>
            <div class="vp-codeblock">
              <div class="vp-codeblock__label">request.txt</div>
              <pre>GET /proxy?url=http://169.254.169.254/latest/meta-data/
Host: target.example
X-Forwarded-Host: lab.xy
User-Agent: research-probe/1.0</pre>
            </div>
          </section>

          <section id="a3">
            <h4>03. Pivot Path</h4>
            <p>
              文章页右侧 rail 会承担真正的信息角色，比如目录、案例参数、相关标签、更新时间，而不是只留下一个孤立 TOC。这样阅读感会更完整。
            </p>
          </section>

          <section id="a4">
            <h4>04. Takeaways</h4>
            <p>
              这个方向的核心是“少一点赛博皮肤感，多一点研究出版感”。它仍然保留技术氛围，但不会靠堆叠霓虹和泛科技渐变来表达专业。
            </p>
          </section>
        </article>
      </div>
    </section>

    <section id="vp-archive" class="vp-shell vp-utility-grid">
      <div class="vp-utility-card">
        <div class="vp-section-head vp-section-head--compact">
          <div>
            <p>Archive view</p>
            <h2>归档页样板</h2>
          </div>
        </div>
        <div class="vp-archive-list">
          {archiveGroups.map((group) => (
            <section class="vp-archive-group">
              <h3>{group.label}</h3>
              {group.items.map((item) => (
                <a href="/" class="vp-archive-item">
                  <span>{item}</span>
                  <span>Open</span>
                </a>
              ))}
            </section>
          ))}
        </div>
      </div>

      <div id="vp-about" class="vp-utility-card">
        <div class="vp-section-head vp-section-head--compact">
          <div>
            <p>About view</p>
            <h2>关于页样板</h2>
          </div>
        </div>
        <div class="vp-about-copy">
          <p>
            这里不再像普通的“自我介绍页面”，而会更接近一份研究者说明书。内容可以保留简洁，但版式会让人觉得这是一个有持续输出和方法论的站点。
          </p>
          <p>
            Author focus: Web security, AD, bug bounty workflows, red-team learning notes. Site intent: document field-tested reasoning, not just publish writeups.
          </p>
        </div>
        <div class="vp-about-facts">
          <span>Based in notes-first workflow</span>
          <span>Bilingual publishing</span>
          <span>Built for long-form reading</span>
        </div>
      </div>
    </section>

    <footer class="vp-footer">
      <div class="vp-shell vp-footer__inner">
        <span>© 2026 Xyvora</span>
        <a href="#vp-home">Back to top</a>
      </div>
    </footer>
  </main>

  <style>
    .vp-page {
      padding: 20px 0 56px;
    }

    .vp-reveal__item {
      opacity: 0;
      transform: translateY(32px);
      transition:
        opacity 0.7s cubic-bezier(0.22, 1, 0.36, 1),
        transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
      transition-delay: calc(var(--vp-item-delay, 0) * 1ms + 120ms);
    }

    .vp-reveal.is-visible .vp-reveal__item {
      opacity: 1;
      transform: translateY(0);
    }

    .vp-reveal.is-visible .vp-reveal__item:nth-child(1) { --vp-item-delay: 0; }
    .vp-reveal.is-visible .vp-reveal__item:nth-child(2) { --vp-item-delay: 120; }
    .vp-reveal.is-visible .vp-reveal__item:nth-child(3) { --vp-item-delay: 240; }
    .vp-reveal.is-visible .vp-reveal__item:nth-child(4) { --vp-item-delay: 360; }

    .vp-topbar {
      position: sticky;
      top: 0;
      z-index: 20;
      border-bottom: 1px solid rgba(24, 17, 13, 0.1);
      backdrop-filter: blur(18px);
      background: color-mix(in srgb, #f8f4ee 82%, transparent);
    }

    .vp-topbar__inner {
      display: grid;
      grid-template-columns: auto 1fr auto;
      gap: 20px;
      align-items: center;
      padding: 16px 24px;
    }

    .vp-brand {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .vp-brand__badge {
      display: inline-grid;
      place-items: center;
      width: 40px;
      height: 40px;
      border: 1px solid var(--vp-line);
      border-radius: 12px;
      background: rgba(255, 255, 255, 0.45);
    }

    .vp-brand__mark {
      display: block;
      width: 24px;
      height: 24px;
      object-fit: contain;
    }

    .vp-brand__wording {
      display: flex;
      flex-direction: column;
      gap: 2px;
      line-height: 1;
    }

    .vp-brand__wording strong {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1rem;
      letter-spacing: -0.03em;
    }

    .vp-brand__text,
    .vp-controls,
    .vp-nav {
      font-size: 0.95rem;
    }

    .vp-nav {
      display: flex;
      justify-content: center;
      gap: 22px;
    }

    .vp-nav a,
    .vp-controls span,
    .vp-footer a {
      text-decoration: none;
      color: var(--vp-muted);
    }

    .vp-nav a {
      position: relative;
      padding: 6px 0;
      transition: color 180ms ease, transform 180ms ease;
    }

    .vp-nav a::after {
      content: '';
      position: absolute;
      left: 0;
      right: 0;
      bottom: -2px;
      height: 2px;
      border-radius: 999px;
      background: linear-gradient(90deg, var(--vp-cyan), var(--vp-accent));
      transform: scaleX(0);
      transform-origin: left center;
      transition: transform 220ms ease;
    }

    .vp-nav a:hover {
      color: var(--vp-ink);
      transform: translateY(-1px);
    }

    .vp-nav a:hover::after,
    .vp-nav a:focus-visible::after {
      transform: scaleX(1);
    }

    .vp-controls {
      display: inline-flex;
      gap: 14px;
      justify-content: flex-end;
    }

    .vp-hero {
      display: grid;
      grid-template-columns: minmax(0, 1.2fr) minmax(320px, 0.8fr);
      gap: 24px;
      padding-top: 40px;
      align-items: stretch;
    }

    .vp-hero__intro,
    .vp-status,
    .vp-feature-card,
    .vp-post-card,
    .vp-utility-card,
    .vp-article,
    .vp-rail-box {
      border: 1px solid var(--vp-line);
      background: var(--vp-panel);
      box-shadow: var(--vp-shadow);
      backdrop-filter: blur(18px);
    }

    .vp-hero__intro {
      position: relative;
      border-radius: var(--vp-radius-xl);
      padding: 44px;
    }

    .vp-kicker,
    .vp-section-head p,
    .vp-article__eyebrow,
    .vp-feature-card__meta,
    .vp-rail-box__title,
    .vp-codeblock__label {
      margin: 0;
      color: var(--vp-accent);
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 0.75rem;
      font-weight: 600;
    }

    .vp-hero h1,
    .vp-section-head h2,
    .vp-feature-card h3,
    .vp-article h3 {
      margin: 0;
      font-family: 'Space Grotesk', sans-serif;
      font-weight: 700;
      letter-spacing: -0.04em;
      line-height: 0.95;
    }

    .vp-hero h1 {
      margin-top: 18px;
      font-size: clamp(3rem, 8vw, 6.4rem);
      max-width: 11ch;
    }

    .vp-lead {
      max-width: 42rem;
      margin: 24px 0 0;
      color: var(--vp-muted);
      font-size: 1.06rem;
      line-height: 1.85;
    }

    .vp-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      margin-top: 28px;
    }

    .vp-button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 48px;
      padding: 0 20px;
      border: 1px solid var(--vp-line-strong);
      border-radius: 999px;
      background: rgba(255, 255, 255, 0.35);
      text-decoration: none;
    }

    .vp-button--primary {
      background: linear-gradient(135deg, var(--vp-accent), #d87e44);
      border-color: transparent;
      color: #fff;
    }

    .vp-status {
      border-radius: var(--vp-radius-xl);
      padding: 22px;
      display: grid;
      gap: 16px;
      align-content: start;
    }

    .vp-status__card,
    .vp-metric,
    .vp-codeblock,
    .vp-archive-item,
    .vp-about-facts span {
      border: 1px solid var(--vp-line);
      background: var(--vp-panel-strong);
    }

    .vp-status__card {
      padding: 18px;
      border-radius: var(--vp-radius-lg);
    }

    .vp-status__label {
      color: var(--vp-muted);
      font-size: 0.84rem;
      margin-bottom: 8px;
    }

    .vp-status__value {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 1.7rem;
      line-height: 1.05;
    }

    .vp-status__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    .vp-metric {
      padding: 16px;
      border-radius: var(--vp-radius-md);
    }

    .vp-metric__label {
      display: block;
      margin-bottom: 8px;
      color: var(--vp-muted);
      font-size: 0.76rem;
      text-transform: uppercase;
      letter-spacing: 0.14em;
    }

    .vp-section-head {
      display: flex;
      align-items: end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 20px;
    }

    .vp-section-head h2 {
      margin-top: 10px;
      font-size: clamp(2rem, 4vw, 3.4rem);
    }

    .vp-section-head span {
      max-width: 30rem;
      color: var(--vp-muted);
      line-height: 1.7;
      text-align: right;
    }

    .vp-featured,
    .vp-grid-section,
    .vp-article-preview,
    .vp-utility-grid {
      margin-top: 44px;
    }

    .vp-feature-card {
      display: grid;
      grid-template-columns: minmax(260px, 0.9fr) minmax(0, 1.1fr);
      gap: 0;
      overflow: hidden;
      border-radius: var(--vp-radius-xl);
    }

    .vp-feature-card__visual {
      position: relative;
      min-height: 360px;
      background:
        radial-gradient(circle at top left, rgba(13, 124, 134, 0.28), transparent 30%),
        radial-gradient(circle at 80% 18%, rgba(180, 73, 31, 0.32), transparent 22%),
        linear-gradient(135deg, #16110d 0%, #2f2016 100%);
      overflow: hidden;
    }

    .vp-feature-card__stamp {
      position: absolute;
      top: 22px;
      left: 22px;
      z-index: 1;
      padding: 8px 12px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      color: rgba(255, 255, 255, 0.86);
      font-family: 'IBM Plex Mono', monospace;
      font-size: 0.78rem;
    }

    .vp-feature-card__grid,
    .vp-feature-card__signal {
      position: absolute;
      inset: 0;
    }

    .vp-feature-card__grid {
      background:
        linear-gradient(rgba(255, 255, 255, 0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.08) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: linear-gradient(180deg, rgba(0, 0, 0, 0.82), transparent);
    }

    .vp-feature-card__signal {
      inset: auto 24px 24px 24px;
      height: 150px;
      border-radius: 999px 999px 16px 16px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background:
        radial-gradient(circle at center, rgba(13, 124, 134, 0.38), transparent 55%),
        linear-gradient(180deg, rgba(255, 255, 255, 0.08), transparent);
      filter: blur(0.2px);
    }

    .vp-feature-card__body {
      padding: 32px;
    }

    .vp-feature-card h3 {
      margin-top: 16px;
      font-size: clamp(2rem, 4vw, 3.4rem);
    }

    .vp-feature-card__summary,
    .vp-post-card p,
    .vp-article p,
    .vp-about-copy p,
    .vp-archive-item {
      color: var(--vp-muted);
      line-height: 1.82;
    }

    .vp-tag-row {
      display: flex;
      flex-wrap: wrap;
      gap: 10px;
      margin-top: 24px;
    }

    .vp-tag-row span {
      padding: 8px 12px;
      border-radius: 999px;
      background: var(--vp-accent-soft);
      color: var(--vp-accent);
      font-size: 0.86rem;
    }

    .vp-card-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .vp-post-card {
      border-radius: var(--vp-radius-lg);
      padding: 24px;
    }

    .vp-post-card__top,
    .vp-post-card__foot,
    .vp-article__meta,
    .vp-archive-item,
    .vp-footer__inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
    }

    .vp-post-card__index,
    .vp-post-card__category,
    .vp-article__meta {
      color: var(--vp-muted);
      font-size: 0.84rem;
    }

    .vp-post-card h3 {
      margin: 18px 0 0;
