---
/**
 * About page — intro about Xyvora / the author.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="关于 - Xyvora" description="About Xyvora - Security researcher, CTF player">
  <div class="about-page">
    <div>
      <h1>关于</h1>
      <p>
        <strong>Xyvora</strong> 是一个专注于 Web 安全研究与 CTF 竞赛的技术博客。
      </p>
      <h2>关于作者</h2>
      <p>
        安全研究员 / CTF 选手。主要方向：Web 渗透测试、漏洞挖掘、红队攻防。
        日常使用 Obsidian 记录学习笔记，本站内容由 Obsidian vault 自动构建发布。
      </p>
      <h2>关于本站</h2>
      <p>
        本站使用 Astro 静态生成，源自 Obsidian 笔记。
        如有问题或合作意向，欢迎通过 GitHub 联系。
      </p>
    </div>
  </div>
</BaseLayout>

<style>
  .about-page {
    max-width: 720px;
    margin: 0 auto;
    padding: 3rem 1.5rem;
    line-height: 1.8;
  }

  .about-page h1 {
    font-size: 2rem;
    font-weight: 700;
    margin: 0 0 1.5rem;
  }

  .about-page h2 {
    font-size: 1.25rem;
    font-weight: 600;
    margin: 2rem 0 0.75rem;
    color: var(--primary);
  }

  .about-page p {
    margin: 0 0 1rem;
    color: var(--text);
  }
</style>
