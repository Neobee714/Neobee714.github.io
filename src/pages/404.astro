---
/**
 * 404 page — terminal-style "not found" page.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="404 - Xyvora" noindex={true}>
  <div class="not-found">
    <div class="not-found__terminal">
      <div class="not-found__header">
        <span class="not-found__dot not-found__dot--red"></span>
        <span class="not-found__dot not-found__dot--yellow"></span>
        <span class="not-found__dot not-found__dot--green"></span>
      </div>
      <div class="not-found__body">
        <p class="not-found__line">$ curl -I {Astro.url.pathname}</p>
        <p class="not-found__line not-found__error">HTTP/1.1 404 Not Found</p>
        <p class="not-found__line">&nbsp;</p>
        <p class="not-found__line">
          <span class="lang-zh">页面不存在。可能已被移动或删除。</span>
          <span class="lang-en">Page not found. It may have been moved or deleted.</span>
        </p>
        <p class="not-found__line">&nbsp;</p>
        <p class="not-found__line">
          <span class="lang-zh">$ <a href="/" class="not-found__link">cd /home</a></span>
          <span class="lang-en">$ <a href="/" class="not-found__link">cd /home</a></span>
        </p>
        <p class="not-found__line not-found__prompt">
          $<span class="not-found__cursor">█</span>
        </p>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 60vh;
    padding: 2rem 1rem;
  }

  .not-found__terminal {
    width: 100%;
    max-width: 560px;
    background: #0d1117;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.75rem;
    overflow: hidden;
    font-family: 'JetBrains Mono', 'Fira Code', monospace;
  }

  .not-found__header {
    display: flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.75rem 1rem;
    background: #161b22;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  .not-found__dot {
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 50%;
  }

  .not-found__dot--red { background: #ff5f57; }
  .not-found__dot--yellow { background: #febc2e; }
  .not-found__dot--green { background: #28c840; }

  .not-found__body {
    padding: 1.5rem;
  }

  .not-found__line {
    margin: 0 0 0.5rem;
    font-size: 0.875rem;
    color: #10b981;
    line-height: 1.8;
  }

  .not-found__error {
    color: #ef4444;
    font-weight: 600;
  }

  .not-found__link {
    color: #60a5fa;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .not-found__link:hover {
    color: #93c5fd;
  }

  .not-found__prompt {
    margin-top: 1rem;
    margin-bottom: 0;
  }

  .not-found__cursor {
    animation: blink 1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }
</style>
